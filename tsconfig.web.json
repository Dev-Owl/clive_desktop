{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.vue", "src/preload/*.d.ts", "src/shared/**/*"]
}
